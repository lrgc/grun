#: grun.c:840
msgid "Choose Application"
msgstr "Выбор приложения"

#: grun.c:867
msgid ""
"gRun launches applications under X\n"
"\n"
"Usage grun [options] [file options]\n"
"\n"
"   file options     Launch file directly, no dialog boxes\n"
"   --persist        Dialog persistance\n"
"   --preload file   Load file as default command\n"
"   --notips         Disable tooltips\n"
"   --version        Show version\n"
"   --help           Show this guide \n"
"\n"
"Copyright Southern Gold Development 1998\n"
msgstr ""
"gRun запускает приложения под X\n"
"\n"
"Использование: grun [параметры] [файл]\n"
"\n"
"   файл             Запустить файл сразу, без диалогового окна\n"
"   --persist        Постоянный диалог\n"
"   --preload файл   Загрузить файл как команду по умолчанию\n"
"   --notips         Отключить подсказки\n"
"   --version        Показать версию\n"
"   --help           Показать эту инструкцию \n"
"\n"
"Copyright Southern Gold Development 1998\n"

#: grun.c:871
#, c-format
msgid ""
"gRun version %s\n"
"\n"
"Copyright Southern Gold Development 1998\n"
msgstr ""
"Версия gRun: %s\n"
"\n"
"Copyright Southern Gold Development 1998\n"

#: grun.c:919 grun.c:920
#, c-format
msgid "gRun %s"
msgstr "gRun %s"

#: grun.c:938
msgid "Launch Application"
msgstr "Запуск приложения"

#: grun.c:977
msgid "OK"
msgstr "OK"

#: grun.c:981
msgid "Launch application"
msgstr "Запустить приложение"

#: grun.c:981
msgid "The OK button launches the application given in the entry box"
msgstr "Кнопка OK запускает приложение, заданное в поле ввода"

#: grun.c:984
msgid "Close"
msgstr "Закрыть"

#: grun.c:987
msgid "Cancel"
msgstr "Отменить"

#: grun.c:993
msgid "Close gRun"
msgstr "Закрыть gRun"

#: grun.c:993
msgid "The Close button will close the persistant gRun window"
msgstr "Кнопка Закрыть закрывает постоянное окно gRun"

#: grun.c:996
msgid "Cancel launch"
msgstr "Отменить запуск"

#: grun.c:996
msgid "The Cancel button cancels the launch process and closes gRun"
msgstr "Кнопка Отменить отменяет процесс запуска и закрывает gRun"

#: grun.c:999
msgid "Browse"
msgstr "Обзор"

#: grun.c:1002
msgid "Browse for command"
msgstr "Выбрать приложение"

#: grun.c:1002
msgid ""
"The Browse button opens a file selection box so the user can browse for the "
"command to launch"
msgstr ""
"Кнопка Обзор открывает окно обзора файлов, где пользователь сможет выбрать "
"команду для запуска"
